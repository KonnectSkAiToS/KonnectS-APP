rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anything not matched below is denied by Firestore's implicit default.
    // (A `match /{document=**} { allow: false }` block does NOT override other
    // matches because rule matches are OR'd, so it is intentionally omitted.)

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin is granted ONLY via a custom claim set server-side (never by the client).
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function changed() {
      return incoming().diff(existing()).affectedKeys();
    }

    function isWorkerUser() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isWorker', false) == true;
    }

    // ---------- 1. Users ----------
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'username', 'createdAt']) &&
               data.uid == userId &&
               data.email is string && data.email.size() <= 256 &&
               data.username is string && data.username.size() <= 64 &&
               (!('firstName' in data) || data.firstName is string) &&
               (!('lastName' in data) || data.lastName is string) &&
               (!('fullName' in data) || data.fullName is string) &&
               (!('isWorker' in data) || data.isWorker is bool) &&
               (!('isOnline' in data) || data.isOnline is bool) &&
               (!('workerType' in data) || data.workerType is string) &&
               (!('rewardsPoints' in data) || (data.rewardsPoints is number && data.rewardsPoints >= 0)) &&
               (!('referralCode' in data) || data.referralCode is string) &&
               (!('carbonSavingsKg' in data) || data.carbonSavingsKg is number) &&
               (!('savedAddresses' in data) || data.savedAddresses is list) &&
               (!('discountBalance' in data) || (data.discountBalance is number && data.discountBalance >= 0)) &&
               (!('referredUsersCount' in data) || data.referredUsersCount is number) &&
               (!('earnedBadges' in data) || data.earnedBadges is list) &&
               (!('invitedBy' in data) || data.invitedBy is string) &&
               (!('availabilityStatus' in data) || data.availabilityStatus is string) &&
               (!('appLanguage' in data) || data.appLanguage is string) &&
               (!('rating' in data) || data.rating is number) &&
               (!('reviewCount' in data) || data.reviewCount is number) &&
               (!('location' in data) || data.location is map) &&
               (!('priceDropNotificationsEnabled' in data) || data.priceDropNotificationsEnabled is bool) &&
               (!('quietHoursEnabled' in data) || data.quietHoursEnabled is bool) &&
               (!('quietHoursStart' in data) || data.quietHoursStart is string) &&
               (!('quietHoursEnd' in data) || data.quietHoursEnd is string) &&
               (!('accessibilityFontScale' in data) || data.accessibilityFontScale is string) &&
               (!('accessibilityHighContrast' in data) || data.accessibilityHighContrast is bool) &&
               (!('darkMode' in data) || data.darkMode is bool) &&
               (!('isPremiumWorker' in data) || data.isPremiumWorker is bool) &&
               (!('premiumExpiryDate' in data) || data.premiumExpiryDate is string) &&
               (!('skills' in data) || data.skills is list) &&
               (!('verificationPhoto' in data) || data.verificationPhoto is string) &&
               (!('featured' in data) || data.featured is bool);
      }

      // Fields a user may set on their OWN profile at sign-up. Trust fields
      // (rating, reviewCount, verificationStatus, isPremiumWorker, featured,
      // premiumExpiryDate, discountBalance) are deliberately NOT creatable.
      function isAllowedCreateKeys(data) {
        return data.keys().hasOnly([
          'uid', 'email', 'username', 'firstName', 'lastName', 'fullName',
          'isWorker', 'isWorkerMode', 'workerType', 'hourlyRate', 'bio',
          'mobileNumber', 'dateOfBirth', 'gender', 'avatarUrl',
          'rewardsPoints', 'referralCode', 'carbonSavingsKg', 'earnedBadges',
          'loginCount', 'createdAt', 'appLanguage', 'darkMode'
        ]);
      }

      // Trust / money-like fields are admin- or server-controlled. Users can
      // only nudge points by a small, non-negative amount and cannot touch the rest.
      function pointsChangeIsSafe() {
        return !changed().hasAny(['rewardsPoints']) ||
               (incoming().rewardsPoints >= 0 &&
                incoming().rewardsPoints - existing().get('rewardsPoints', 0) <= 100);
      }

      function loginCountIsSafe() {
        return !changed().hasAny(['loginCount']) ||
               incoming().loginCount == existing().get('loginCount', 0) + 1;
      }

      // 'verified' is only ever granted by an admin and cannot be removed/forged by the user.
      function verificationIsSafe() {
        return !changed().hasAny(['verificationStatus']) ||
               (existing().get('verificationStatus', '') != 'verified' &&
                incoming().verificationStatus in ['unverified', 'pending', 'in_progress', 'rejected']);
      }

      // Signed-in users can fetch a single profile by uid (needed for chat, listings
      // and bookings) but cannot list/scan the collection. Admins can list.
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if isOwner(userId) &&
                    isValidUser(incoming()) &&
                    isAllowedCreateKeys(incoming()) &&
                    incoming().createdAt == request.time &&
                    incoming().get('rewardsPoints', 0) <= 100;

      allow update: if (
        isOwner(userId) &&
        changed().hasOnly([
          'username', 'firstName', 'lastName', 'fullName', 'mobileNumber', 'avatarUrl',
          'workerType', 'isWorker', 'isOnline', 'updatedAt', 'savedItems',
          'verificationStatus', 'verificationStep', 'documents', 'hourlyRate',
          'isWorkerMode', 'autoAcceptConfig', 'rewardsPoints', 'referralCode',
          'dateOfBirth', 'gender', 'bio', 'carbonSavingsKg', 'savedAddresses',
          'referredUsersCount', 'earnedBadges', 'invitedBy',
          'availabilityStatus', 'appLanguage', 'location',
          'priceDropNotificationsEnabled', 'quietHoursEnabled', 'quietHoursStart',
          'quietHoursEnd', 'accessibilityFontScale', 'accessibilityHighContrast',
          'darkMode', 'skills', 'verificationPhoto', 'loginCount',
          'workHistory', 'pastProjects', 'certifications', 'hasUploadedDocs'
        ]) &&
        pointsChangeIsSafe() &&
        loginCountIsSafe() &&
        verificationIsSafe() &&
        isValidUser(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        (!changed().hasAny(['updatedAt']) || incoming().updatedAt == request.time)
      ) || isAdmin();

      allow delete: if false;
    }

    // ---------- 1.1 Login index ----------
    // Lets the login screen resolve username/mobile -> email with a single `get`
    // (no listing / scraping). Keys look like "u_<username>" or "m_<digits>".
    match /login_index/{key} {
      allow get: if true;
      allow list: if false;
      function isValidIndexEntry(data) {
        return data.keys().hasOnly(['uid', 'email', 'username']) &&
               data.uid == request.auth.uid &&
               data.email == request.auth.token.email &&
               key.size() <= 300;
      }
      // Create a new key, or re-write one you already own. You can never take over someone else's key.
      allow create: if isSignedIn() && isValidIndexEntry(incoming());
      allow update: if isOwner(existing().uid) && isValidIndexEntry(incoming());
      allow delete: if isOwner(existing().uid);
    }

    // ---------- 1.2 Public worker directory ----------
    // Safe, shareable subset of a worker's profile (no email, phone, DOB or documents), so the directory
    // never needs to list /users. Trust fields must equal the real values on the owner's own /users doc,
    // so a worker can mirror them but never forge a rating or "verified" badge.
    match /public_profiles/{userId} {
      function ownDoc() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function isValidPublicProfile(data) {
        return data.keys().hasOnly([
                 'uid', 'username', 'fullName', 'avatarUrl', 'workerType', 'skills', 'hourlyRate',
                 'availabilityStatus', 'bio', 'location', 'isWorker', 'rating', 'reviewCount',
                 'verificationStatus', 'isPremiumWorker', 'featured', 'updatedAt'
               ]) &&
               data.uid == request.auth.uid &&
               data.username is string && data.username.size() <= 64 &&
               data.get('isWorker', false) == true &&
               data.get('rating', 0) == ownDoc().get('rating', 0) &&
               data.get('reviewCount', 0) == ownDoc().get('reviewCount', 0) &&
               data.get('verificationStatus', '') == ownDoc().get('verificationStatus', '') &&
               data.get('isPremiumWorker', false) == ownDoc().get('isPremiumWorker', false) &&
               data.get('featured', false) == ownDoc().get('featured', false) &&
               (!('updatedAt' in data) || data.updatedAt == request.time);
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 100;
      allow create, update: if isOwner(userId) && isValidPublicProfile(incoming());
      allow delete: if isOwner(userId);
    }

    // ---------- 2. Marketplace items ----------
    match /items/{itemId} {
      function isValidItem(data) {
        return data.keys().hasAll(['sellerId', 'title', 'price', 'isFree', 'status', 'createdAt']) &&
               data.sellerId == request.auth.uid &&
               data.title is string && data.title.size() <= 100 &&
               data.price is number && (data.isFree ? data.price == 0 : data.price >= 0) &&
               data.status in ['available', 'sold', 'deleted', 'pending_pickup', 'delivered', 'pending'] &&
               data.createdAt is timestamp &&
               (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
               (!('condition' in data) || data.condition in ['new', 'used_good', 'used_fair', 'parts']) &&
               (!('images' in data) || data.images is list) &&
               (!('location' in data) || (data.location is map && data.location.address is string));
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidItem(incoming()) && incoming().createdAt == request.time;
      // Only the seller may update, only whitelisted fields, always re-validated.
      allow update: if isOwner(existing().sellerId) &&
                    changed().hasOnly(['title', 'description', 'price', 'isFree', 'status', 'images', 'location', 'updatedAt', 'category', 'condition']) &&
                    isValidItem(incoming()) &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if false; // Soft delete via status
    }

    // ---------- 2.1 Offers ----------
    match /offers/{offerId} {
      function isValidOffer(data) {
        return data.keys().hasAll(['itemId', 'sellerId', 'buyerId', 'offerPrice', 'status', 'createdAt']) &&
               data.offerPrice is number && data.offerPrice > 0 &&
               data.status == 'pending' &&
               data.createdAt is timestamp &&
               (!('itemTitle' in data) || data.itemTitle is string) &&
               (!('buyerDisplayName' in data) || data.buyerDisplayName is string) &&
               (!('originalPrice' in data) || data.originalPrice is number);
      }

      allow read: if isSignedIn() && (isOwner(resource.data.buyerId) || isOwner(resource.data.sellerId));
      allow create: if isSignedIn() &&
                    incoming().buyerId == request.auth.uid &&
                    incoming().sellerId != request.auth.uid &&
                    isValidOffer(incoming()) &&
                    incoming().createdAt == request.time &&
                    // sellerId must really be the item's seller
                    get(/databases/$(database)/documents/items/$(incoming().itemId)).data.sellerId == incoming().sellerId;
      // Only the seller can accept/reject; the buyer can only withdraw (reject) their own offer.
      allow update: if changed().hasOnly(['status']) &&
                    (
                      (isOwner(existing().sellerId) && incoming().status in ['accepted', 'rejected']) ||
                      (isOwner(existing().buyerId) && incoming().status == 'rejected')
                    );
    }

    // ---------- 3. Chats ----------
    match /chats/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['senderId', 'recipientId', 'text', 'timestamp', 'roomId']) &&
               data.senderId == request.auth.uid &&
               data.text is string && data.text.size() <= 1000 &&
               data.timestamp is timestamp &&
               data.roomId is string && data.roomId.size() <= 256 &&
               (!('participants' in data) || (data.participants is list && request.auth.uid in data.participants));
      }

      allow read: if isSignedIn() && (
        (resource.data.keys().hasAny(['participants']) && request.auth.uid in resource.data.participants) ||
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidMessage(incoming()) && incoming().timestamp == request.time;
    }

    // ---------- 4. Bookings ----------
    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return data.keys().hasAll(['customerId', 'serviceType', 'status', 'createdAt']) &&
               data.customerId is string &&
               data.serviceType is string && data.serviceType.size() <= 100 &&
               data.status in ['pending', 'accepted', 'completed', 'cancelled', 'timed_out', 'negotiating'] &&
               (data.createdAt is timestamp || data.createdAt is string) &&
               (!('suggestedPrice' in data) || data.suggestedPrice is number) &&
               (!('estimatedCompletionTime' in data) || data.estimatedCompletionTime is string);
      }

      // Customers see their own bookings, assigned workers see theirs, and
      // worker accounts can browse the job board. Other customers cannot read them.
      allow read: if isOwner(resource.data.customerId) ||
                     isOwner(resource.data.get('workerId', '')) ||
                     isWorkerUser();

      allow create: if isSignedIn() &&
                    incoming().customerId == request.auth.uid &&
                    isValidBooking(incoming()) &&
                    incoming().createdAt == request.time;

      allow update: if isSignedIn() &&
                    isValidBooking(incoming()) &&
                    incoming().customerId == existing().customerId &&
                    (
                      // Customer actions
                      (isOwner(existing().customerId) &&
                       changed().hasOnly(['status', 'description', 'updatedAt', 'suggestedPrice', 'autoRenew', 'createdAt'])) ||
                      // A worker claiming an unassigned job (accept or counter-offer)
                      (isWorkerUser() &&
                       existing().get('workerId', null) == null &&
                       existing().status in ['pending', 'negotiating'] &&
                       changed().hasOnly(['workerId', 'status', 'suggestedPrice', 'estimatedCompletionTime', 'updatedAt']) &&
                       incoming().workerId == request.auth.uid &&
                       incoming().status in ['accepted', 'negotiating']) ||
                      // The assigned worker progressing their own job
                      (isOwner(existing().get('workerId', '')) &&
                       changed().hasOnly(['status', 'suggestedPrice', 'estimatedCompletionTime', 'updatedAt']))
                    );
    }

    // ---------- 5. AR snapshots ----------
    match /ar_snapshots/{snapshotId} {
      function isValidArSnapshot(data) {
        return data.keys().hasAll(['userId', 'itemId', 'itemTitle', 'scale', 'rotate', 'offset', 'timestamp']) &&
               data.userId == request.auth.uid &&
               data.itemId is string && data.itemId.size() <= 128 &&
               data.itemTitle is string && data.itemTitle.size() <= 256 &&
               data.scale is number &&
               data.rotate is number &&
               data.offset is map &&
               data.offset.x is number && data.offset.y is number &&
               data.timestamp is timestamp &&
               (!('itemCategory' in data) || data.itemCategory is string) &&
               (!('itemImage' in data) || data.itemImage is string);
      }

      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidArSnapshot(incoming()) && incoming().timestamp == request.time;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // ---------- 6. AR library placements ----------
    match /ar_library/{placementId} {
      function isValidArLibraryPlacement(data) {
        return data.keys().hasAll(['userId', 'itemId', 'arScale', 'arRotate', 'arDragOffset', 'savedAt']) &&
               data.userId == request.auth.uid &&
               data.itemId is string && data.itemId.size() <= 128 &&
               data.arScale is number &&
               data.arRotate is number &&
               data.arDragOffset is map &&
               data.arDragOffset.x is number && data.arDragOffset.y is number &&
               data.savedAt is timestamp;
      }

      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidArLibraryPlacement(incoming()) && incoming().savedAt == request.time;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidArLibraryPlacement(incoming()) && incoming().savedAt == request.time;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // ---------- 7. SOS alerts ----------
    // Must be signed in and tied to the caller's own uid (no anonymous spam).
    match /sos_alerts/{alertId} {
      allow create: if isSignedIn() &&
                    incoming().userId == request.auth.uid &&
                    incoming().keys().size() <= 20;
      allow read: if isOwner(resource.data.userId) || isAdmin();
    }

    // ---------- 8. Reviews ----------
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                    incoming().userId == request.auth.uid &&
                    incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 &&
                    incoming().comment is string && incoming().comment.size() <= 1000 &&
                    incoming().createdAt == request.time &&
                    (('productId' in incoming()) || ('providerId' in incoming())) &&
                    // no reviewing yourself
                    (!('providerId' in incoming()) || incoming().providerId != request.auth.uid);
      allow update, delete: if false;
    }

    // ---------- 9/11. Ledgers, rentals, CRM clients ----------
    // No client code uses these collections; locked until a feature needs them.
    match /ledgers/{id} { allow read, write: if false; }
    match /rentals/{id} { allow read, write: if false; }
    match /crm_clients/{id} { allow read, write: if false; }

    // ---------- 10. Contractor CRM (private to the contractor) ----------
    match /contractor_crm/{crmId} {
      allow read, delete: if isOwner(resource.data.contractorId);
      allow create: if isSignedIn() && incoming().contractorId == request.auth.uid;
      allow update: if isOwner(existing().contractorId) && incoming().contractorId == existing().contractorId;
    }

    // ---------- 12. HMRC logs (private to the worker) ----------
    match /hmrc_logs/{logId} {
      allow read, delete: if isOwner(resource.data.workerId);
      allow create: if isSignedIn() && incoming().workerId == request.auth.uid;
      allow update: if isOwner(existing().workerId) && incoming().workerId == existing().workerId;
    }

    // ---------- 14. Discussions ----------
    match /discussions/{discussionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                    incoming().authorId == request.auth.uid &&
                    incoming().title is string && incoming().title.size() <= 200 &&
                    incoming().content is string && incoming().content.size() <= 5000 &&
                    incoming().createdAt == request.time;
      // Anyone signed in may add ONE reply or ONE reaction at a time; nothing else.
      allow update: if isSignedIn() &&
                    changed().hasOnly(['replies', 'reactions']) &&
                    (!changed().hasAny(['reactions']) ||
                      (incoming().reactions is number && incoming().reactions - existing().get('reactions', 0) <= 1 && incoming().reactions >= 0)) &&
                    (!changed().hasAny(['replies']) ||
                      (incoming().replies is list && incoming().replies.size() <= existing().get('replies', []).size() + 1));
      allow delete: if isOwner(resource.data.authorId);
    }

    // ---------- 15. Safety alerts ----------
    match /safety_alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                    (!('userId' in incoming()) || incoming().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---------- 16. Community pulse ----------
    match /community_pulse/{pulseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Support (+1) and RSVP (add/remove one entry) only.
      allow update: if isSignedIn() &&
                    changed().hasOnly(['supportersCount', 'rsvpedUsers']) &&
                    (!changed().hasAny(['supportersCount']) ||
                      (incoming().supportersCount is number && incoming().supportersCount - existing().get('supportersCount', 0) == 1)) &&
                    (!changed().hasAny(['rsvpedUsers']) ||
                      (incoming().rsvpedUsers is list &&
                       incoming().rsvpedUsers.size() - existing().get('rsvpedUsers', []).size() <= 1 &&
                       existing().get('rsvpedUsers', []).size() - incoming().rsvpedUsers.size() <= 1));
      allow delete: if isAdmin();
    }

    // ---------- 17. Community chats ----------
    match /community_chats/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                    incoming().senderId == request.auth.uid &&
                    incoming().text is string && incoming().text.size() <= 1000 &&
                    incoming().timestamp == request.time;
      allow update, delete: if false;
    }

    // ---------- 18. Feedback (write-only for users, readable by admins) ----------
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- 19. Audit logs (append-only, admin-readable) ----------
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- 21. Map hubs (read-only reference data) ----------
    match /hubs/{hubId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- 22. Volunteer hours (owner logs, admin approves) ----------
    match /volunteer_hours/{entryId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() &&
                    incoming().keys().hasOnly(['userId', 'charityName', 'hours', 'note', 'status', 'createdAt']) &&
                    incoming().userId == request.auth.uid &&
                    incoming().charityName is string && incoming().charityName.size() <= 200 &&
                    incoming().hours is number && incoming().hours > 0 && incoming().hours <= 24 &&
                    incoming().get('note', '') is string && incoming().get('note', '').size() <= 1000 &&
                    incoming().status == 'pending' &&
                    incoming().createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // ---------- 20. Admin-only data ----------
    match /activity_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
