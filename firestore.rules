rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'username', 'createdAt']) &&
               data.uid is string && data.uid.size() <= 128 &&
               data.email is string && data.email.size() <= 256 &&
               data.username is string && data.username.size() <= 64 &&
               (!('firstName' in data) || data.firstName is string) &&
               (!('lastName' in data) || data.lastName is string) &&
               (!('fullName' in data) || data.fullName is string) &&
               (!('isWorker' in data) || data.isWorker is bool) &&
               (!('isOnline' in data) || data.isOnline is bool) &&
               (!('workerType' in data) || data.workerType is string) &&
               (!('rewardsPoints' in data) || data.rewardsPoints is number) &&
               (!('referralCode' in data) || data.referralCode is string);
      }

      allow get: if isSignedIn();
      allow list: if false; 
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && (
        // Only allow updating non-critical fields
        incoming().diff(existing()).affectedKeys().hasOnly([
          'username', 'firstName', 'lastName', 'fullName', 'mobileNumber', 'avatarUrl', 
          'workerType', 'isWorker', 'isOnline', 'updatedAt', 'savedItems',
          'verificationStatus', 'verificationStep', 'documents', 'hourlyRate',
          'isWorkerMode', 'autoAcceptConfig', 'rewardsPoints', 'referralCode',
          'dateOfBirth', 'gender', 'bio'
        ]) &&
        // Security Guard: Prevent user from self-verifying to 'verified'
        (
          !incoming().diff(existing()).affectedKeys().hasAny(['verificationStatus']) ||
          incoming().verificationStatus != 'verified'
        ) &&
        isValidUser(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        // If updatedAt is changed, it must be the server time
        (!incoming().diff(existing()).affectedKeys().hasAny(['updatedAt']) || 
         incoming().updatedAt == request.time)
      );
    }

    // 2. Marketplace Item Rules
    match /items/{itemId} {
      function isValidItem(data) {
        return data.keys().hasAll(['sellerId', 'title', 'price', 'isFree', 'status', 'createdAt']) &&
               data.sellerId == request.auth.uid &&
               data.title is string && data.title.size() <= 100 &&
               data.price is number && (data.isFree ? data.price == 0 : data.price >= 0) &&
               data.status in ['available', 'sold', 'deleted', 'pending_pickup', 'delivered', 'pending'] &&
               data.createdAt is timestamp &&
               (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
               (!('condition' in data) || data.condition in ['new', 'used_good', 'used_fair', 'parts']) &&
               (!('images' in data) || data.images is list) &&
               (!('location' in data) || (data.location is map && data.location.address is string));
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidItem(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && (
        isOwner(existing().sellerId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'price', 'isFree', 'status', 'images', 'location', 'updatedAt', 'category', 'condition']) &&
          isValidItem(incoming()) &&
          incoming().createdAt == existing().createdAt
        ) ||
        // Allow others to update status (e.g. mark as sold if it's a platform action, but restricted usually)
        (isOwner(existing().sellerId) && incoming().diff(existing()).affectedKeys().hasAny(['status']))
      );
      allow delete: if false; // Soft delete via status
    }

    // 2.1 Offers Rules
    match /offers/{offerId} {
      function isValidOffer(data) {
        return data.keys().hasAll(['itemId', 'sellerId', 'buyerId', 'offerPrice', 'status', 'createdAt']) &&
               data.offerPrice is number && data.offerPrice > 0 &&
               data.status in ['pending', 'accepted', 'rejected'] &&
               data.createdAt is timestamp &&
               (!('itemTitle' in data) || data.itemTitle is string) &&
               (!('buyerDisplayName' in data) || data.buyerDisplayName is string) &&
               (!('originalPrice' in data) || data.originalPrice is number);
      }

      allow read: if isSignedIn() && (isOwner(resource.data.buyerId) || isOwner(resource.data.sellerId));
      allow create: if isSignedIn() && incoming().buyerId == request.auth.uid && isValidOffer(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && (isOwner(existing().sellerId) || isOwner(existing().buyerId)) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    incoming().status in ['accepted', 'rejected'];
    }

    // 3. Chat Rules
    match /chats/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['senderId', 'recipientId', 'text', 'timestamp', 'roomId']) &&
               data.senderId == request.auth.uid &&
               data.text is string && data.text.size() <= 1000 &&
               data.timestamp is timestamp &&
               data.roomId is string && data.roomId.size() <= 256 &&
               (!('participants' in data) || (data.participants is list && request.auth.uid in data.participants));
      }

      allow read: if isSignedIn() && (
        (resource.data.keys().hasAny(['participants']) && request.auth.uid in resource.data.participants) ||
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidMessage(incoming()) && incoming().timestamp == request.time;
    }

    // 4. Booking Rules
    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return data.keys().hasAll(['customerId', 'serviceType', 'status', 'createdAt']) &&
               data.customerId is string &&
               data.serviceType is string && data.serviceType.size() <= 100 &&
               data.status in ['pending', 'accepted', 'completed', 'cancelled', 'timed_out', 'negotiating'] &&
               data.createdAt is timestamp &&
               (!('suggestedPrice' in data) || data.suggestedPrice is number) &&
               (!('estimatedCompletionTime' in data) || data.estimatedCompletionTime is string);
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid && 
                    isValidBooking(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && (
        // Customer actions
        (isOwner(existing().customerId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'updatedAt', 'suggestedPrice'])) ||
        // Worker actions (accepting or countering)
        (incoming().diff(existing()).affectedKeys().hasAny(['workerId', 'status', 'suggestedPrice', 'estimatedCompletionTime', 'updatedAt']) && 
         (incoming().status in ['accepted', 'negotiating'])) ||
        // Assigned worker actions
        (existing().workerId != null && isOwner(existing().workerId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      ) && isValidBooking(incoming()) && incoming().createdAt == existing().createdAt;
    }

    // 5. AR Snapshots Rules
    match /ar_snapshots/{snapshotId} {
      function isValidArSnapshot(data) {
        return data.keys().hasAll(['userId', 'itemId', 'itemTitle', 'scale', 'rotate', 'offset', 'timestamp']) &&
               data.userId == request.auth.uid &&
               data.itemId is string && data.itemId.size() <= 128 &&
               data.itemTitle is string && data.itemTitle.size() <= 256 &&
               data.scale is number &&
               data.rotate is number &&
               data.offset is map &&
               data.offset.x is number && data.offset.y is number &&
               data.timestamp is timestamp &&
               (!('itemCategory' in data) || data.itemCategory is string) &&
               (!('itemImage' in data) || data.itemImage is string);
      }

      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidArSnapshot(incoming()) && incoming().timestamp == request.time;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 6. AR Library Placement Rules
    match /ar_library/{placementId} {
      function isValidArLibraryPlacement(data) {
        return data.keys().hasAll(['userId', 'itemId', 'arScale', 'arRotate', 'arDragOffset', 'savedAt']) &&
               data.userId == request.auth.uid &&
               data.itemId is string && data.itemId.size() <= 128 &&
               data.arScale is number &&
               data.arRotate is number &&
               data.arDragOffset is map &&
               data.arDragOffset.x is number && data.arDragOffset.y is number &&
               data.savedAt is timestamp;
      }

      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidArLibraryPlacement(incoming()) && incoming().savedAt == request.time;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidArLibraryPlacement(incoming()) && incoming().savedAt == request.time;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 7. SOS Alerts Rules
    match /sos_alerts/{alertId} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid);
    }

    // 8. Reviews Rules
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // 9. Ledger Rules (Skill Swap)
    match /ledgers/{ledgerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // 10. CRM Client Rules
    match /crm_clients/{crmId} {
      allow read, write: if isSignedIn();
    }

    // 11. Rentals Rules
    match /rentals/{rentalId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }
  }
}
